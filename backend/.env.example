# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=resume_builder

# ─── JWT signing secret (keep private; set a unique 32+ character value) ──────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# ─── Gemini via LangChain (optional — deterministic fallbacks remain available) ─
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ─── Tavily (Web Search Agent — JD Pipeline) ──────────────────────────────────
# Required for company intel search in the JD-based resume generator
# Get key at: https://tavily.com  (free tier available)
TAVILY_API_KEY=your-tavily-api-key

# ─── GitHub Token (Repo Fetch Agent — JD Pipeline) ────────────────────────────
# Used to fetch user's GitHub repos and pick the most relevant ones
# Create at: https://github.com/settings/tokens (scopes: public_repo)
GITHUB_TOKEN=your-github-personal-access-token

# ─── LaTeX / PDF backend ──────────────────────────────────────────────────────
# Options: "latexonline" (no install needed) | "local" (requires pdflatex)
LATEX_BACKEND=latexonline
LATEX_ONLINE_URL=https://latexonline.cc/compile

# ─── CORS Origins (JSON array; use the exact Vercel production origin) ────────
# Example: ALLOWED_ORIGINS=["https://your-app.vercel.app"]
# In Render, set ALLOWED_ORIGINS to a JSON array containing your Vercel origin.

# ─── Debug ───────────────────────────────────────────────────────────────────
DEBUG=false
