# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=resume_builder

# ─── JWT Secret (change in production!) ──────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE_MINUTES=1440

# ─── Agent 1 — Groq (Generator + Summary + Review agents) ────────────────────
# Get key at: https://console.groq.com
# Used by: web summary agent, resume generate agent, review agent
GROQ_API_KEY=your-groq-api-key
AGENT1_MODEL=llama-3.3-70b-versatile

# ─── Agent 2 — OpenRouter (Quality Verifier) ──────────────────────────────────
# Get key at: https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-api-key
AGENT2_MODEL=meta-llama/llama-3.1-405b-instruct

# ─── Tavily (Web Search Agent — JD Pipeline) ──────────────────────────────────
# Required for company intel search in the JD-based resume generator
# Get key at: https://tavily.com  (free tier available)
TAVILY_API_KEY=your-tavily-api-key

# ─── GitHub Token (Repo Fetch Agent — JD Pipeline) ────────────────────────────
# Used to fetch user's GitHub repos and pick the most relevant ones
# Create at: https://github.com/settings/tokens (scopes: public_repo)
GITHUB_TOKEN=your-github-personal-access-token

# ─── LaTeX / PDF backend ──────────────────────────────────────────────────────
# Options: "latexonline" (no install needed) | "local" (requires pdflatex)
LATEX_BACKEND=latexonline
LATEX_ONLINE_URL=https://latexonline.cc/compile

# ─── CORS Origins (comma-separated) ──────────────────────────────────────────
# Defaults: http://localhost:5173,http://localhost:3000
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Debug ───────────────────────────────────────────────────────────────────
DEBUG=false
