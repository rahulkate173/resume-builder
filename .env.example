# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=resume_builder

# ─── JWT Secret ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this

# ─── Agent 1 — Grok / Qwen (via Groq) ────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
AGENT1_MODEL=llama-3.3-70b-versatile   # e.g. llama-3.3-70b-versatile (Qwen via Groq)

# ─── Agent 2 — GPT OSS 120B (via OpenRouter / Together) ──────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key
AGENT2_MODEL=meta-llama/llama-3.1-405b-instruct   # 405B class OSS model

# ─── LLM 3 — Mistral Small ───────────────────────────────────────────────────
MISTRALAI_API_KEY=your-mistral-api-key
LLM3_MODEL=mistral-small-latest

# ─── LangSmith (optional tracing) ────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=resume-builder

# ─── LaTeX MCP (PDF generation) ──────────────────────────────────────────────
# Options: "local" | "latexonline" | "overleaf_api"
LATEX_BACKEND=latexonline
# Used only when LATEX_BACKEND=latexonline
LATEX_ONLINE_URL=https://latexonline.cc/compile